{
  "name": "@ideavo/webpack-tagger",
  "version": "1.0.2",
  "description": "A webpack loader that automatically adds ideavo attributes to your React components in Next.js.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "npm run build -- --watch",
    "lint": "eslint . --max-warnings 0",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webpack",
    "webpack-loader",
    "nextjs",
    "react",
    "ideavo"
  ],
  "author": "Your Name",
  "license": "MIT",
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.23.0",
    "estree-walker": "^2.0.2",
    "magic-string": "^0.30.5"
  },
  "devDependencies": {
    "@types/node": "^20.8.9",
    "@types/webpack": "^5.28.5",
    "eslint": "^8.52.0",
    "tsup": "^8.0.2",
    "typescript": "^5.2.2"
  },
  "allowScripts": {
    "esbuild@0.25.10": true,
    "fsevents@2.3.3": true
  }
}
